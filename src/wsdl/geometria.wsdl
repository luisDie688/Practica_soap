<?xml version="1.0" encoding="UTF-8"?>

<definitions
    name="GeometriaService"
    targetNamespace="http://ejemplo.com/geometria"

    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:tns="http://ejemplo.com/geometria"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/">

    <!-- ========================= -->
    <!-- TIPOS -->
    <!-- ========================= -->

    <types>

        <xsd:schema
            targetNamespace="http://ejemplo.com/geometria"
            elementFormDefault="qualified">


            <xsd:element name="AreaRectangulo">

                <xsd:complexType>

                    <xsd:sequence>

                        <xsd:element
                            name="base"
                            type="xsd:double"/>

                        <xsd:element
                            name="altura"
                            type="xsd:double"/>

                    </xsd:sequence>

                </xsd:complexType>

            </xsd:element>


            <xsd:element name="AreaRectanguloResponse">

                <xsd:complexType>

                    <xsd:sequence>

                        <xsd:element
                            name="area"
                            type="xsd:double"/>

                    </xsd:sequence>

                </xsd:complexType>

            </xsd:element>


            <xsd:element name="PerimetroRectangulo">

                <xsd:complexType>

                    <xsd:sequence>

                        <xsd:element
                            name="base"
                            type="xsd:double"/>

                        <xsd:element
                            name="altura"
                            type="xsd:double"/>

                    </xsd:sequence>

                </xsd:complexType>

            </xsd:element>


            <xsd:element name="PerimetroRectanguloResponse">

                <xsd:complexType>

                    <xsd:sequence>

                        <xsd:element
                            name="perimetro"
                            type="xsd:double"/>

                    </xsd:sequence>

                </xsd:complexType>

            </xsd:element>

        </xsd:schema>

    </types>


    <!-- ========================= -->
    <!-- MENSAJES -->
    <!-- ========================= -->

    <message name="AreaRectanguloRequest">

        <part
            name="parameters"
            element="tns:AreaRectangulo"/>

    </message>


    <message name="AreaRectanguloResponse">

        <part
            name="parameters"
            element="tns:AreaRectanguloResponse"/>

    </message>


    <message name="PerimetroRectanguloRequest">

        <part
            name="parameters"
            element="tns:PerimetroRectangulo"/>

    </message>


    <message name="PerimetroRectanguloResponse">

        <part
            name="parameters"
            element="tns:PerimetroRectanguloResponse"/>

    </message>


    <!-- ========================= -->
    <!-- OPERACIONES -->
    <!-- ========================= -->

    <portType name="GeometriaPortType">

        <operation name="AreaRectangulo">

            <input
                message="tns:AreaRectanguloRequest"/>

            <output
                message="tns:AreaRectanguloResponse"/>

        </operation>


        <operation name="PerimetroRectangulo">

            <input
                message="tns:PerimetroRectanguloRequest"/>

            <output
                message="tns:PerimetroRectanguloResponse"/>

        </operation>

    </portType>


    <!-- ========================= -->
    <!-- BINDING -->
    <!-- ========================= -->

    <binding
        name="GeometriaBinding"
        type="tns:GeometriaPortType">

        <soap:binding
            style="document"
            transport="http://schemas.xmlsoap.org/soap/http"/>


        <operation name="AreaRectangulo">

            <soap:operation
                soapAction="AreaRectangulo"/>

            <input>
                <soap:body use="literal"/>
            </input>

            <output>
                <soap:body use="literal"/>
            </output>

        </operation>


        <operation name="PerimetroRectangulo">

            <soap:operation
                soapAction="PerimetroRectangulo"/>

            <input>
                <soap:body use="literal"/>
            </input>

            <output>
                <soap:body use="literal"/>
            </output>

        </operation>

    </binding>


    <!-- ========================= -->
    <!-- SERVICIO -->
    <!-- ========================= -->

    <service name="GeometriaService">

        <port
            name="GeometriaPort"
            binding="tns:GeometriaBinding">

            <soap:address
                location="http://localhost:3000/soap/geometria"/>

        </port>

    </service>

</definitions>